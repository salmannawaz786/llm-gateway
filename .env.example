# --- Gateway ---
GATEWAY_LOG_LEVEL=INFO
GATEWAY_DATABASE_URL=sqlite:///./gateway.db

# --- Providers -------------------------------------------------------------
# The gateway runs fully offline against the built-in mock provider.
# Real providers are OPTIONAL. Both listed below have free tiers.

# https://console.groq.com/keys  (free tier)
GATEWAY_GROQ_API_KEY=
GATEWAY_GROQ_MODEL=llama-3.1-8b-instant

# https://aistudio.google.com/apikey  (free tier)
GATEWAY_GEMINI_API_KEY=
GATEWAY_GEMINI_MODEL=gemini-2.0-flash

# --- Reliability -----------------------------------------------------------
GATEWAY_HEDGE_DELAY_MS=800
GATEWAY_RETRY_BUDGET_RATIO=0.15
GATEWAY_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_BREAKER_RECOVERY_SECONDS=15

# --- Semantic cache --------------------------------------------------------
GATEWAY_CACHE_ENABLED=true
# Leave unset to use the embedder's calibrated threshold (recommended).
# GATEWAY_CACHE_SIMILARITY_THRESHOLD=
GATEWAY_CACHE_MAX_TEMPERATURE=0.8
